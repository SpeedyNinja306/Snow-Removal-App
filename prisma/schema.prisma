// SR-App data model (ADR-002: PostgreSQL via Prisma as the sole data layer).
//
// Scaffold scope: User, Customer, ServiceLocation and Job (foundation only —
// no assignment, invoicing, notes/photos, or status-transition logic yet).
// Trucks, invoices, payments, time entries, notes, photos, location pings and
// audit events are added by their own feature tickets.
//
// Job.status mirrors the canonical 9-state lifecycle in
// docs/steering/domain/jobs-lifecycle.md section 2 exactly (ADR-022,
// resolved). No transition allow-list/state machine exists yet — this
// ticket is schema-only.
//
// Prisma 7 (ADR-020): the datasource carries no `url`. The CLI reads the
// connection string from `prisma.config.ts`; the runtime client passes one
// through the `@prisma/adapter-pg` driver adapter (see `lib/db/index.ts`).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  DISPATCH
  FIELD_AGENT
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  role           Role
  // Deactivation instead of deletion: users are referenced by operational
  // history, and authorization re-reads `active` on every request (ADR-015).
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Jobs currently assigned to this user as the field agent (ADR-023).
  assignedJobs Job[] @relation("JobAssignee")

  // Audit-trail entries this user performed (domain/audit-logging.md). Restrict
  // (via AuditEvent) keeps the actor referenced by history from being deleted.
  auditEvents AuditEvent[] @relation("AuditActor")

  @@map("users")
}

// Canonical lifecycle states (domain/jobs-lifecycle.md section 2; ADR-022).
// The transition allow-list and state machine are out of scope for this
// schema-only ticket — no enforcement exists yet.
enum JobStatus {
  DRAFT
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELED
  CLOSED
}

model Customer {
  id    String @id @default(cuid())
  name  String
  phone String?
  email String?
  // domain/customers-service-locations.md: "optional billing notes".
  billingNotes String?
  // Deactivation instead of deletion: customers are referenced by jobs and
  // must never be hard-deleted once operational history exists.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceLocations ServiceLocation[]

  @@index([active])
  @@map("customers")
}

model ServiceLocation {
  id         String @id @default(cuid())
  customerId String
  // Restrict, not cascade: a location with job history must be deactivated,
  // never removed by deleting its customer (domain/customers-service-locations.md).
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  // domain/customers-service-locations.md: "optional unit/access notes".
  accessNotes String?

  // Geocoded once at save time and persisted (ADR-009); never geocoded per
  // map render. `geocoded=false` + null coords means geocoding hasn't run or
  // failed yet — manual coordinates are allowed in that case.
  latitude  Float?
  longitude Float?
  geocoded  Boolean @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([customerId])
  @@index([active])
  @@map("service_locations")
}

model Job {
  id                String @id @default(cuid())
  serviceLocationId String
  // Restrict: jobs are operational history and must never disappear via a
  // cascaded delete of their location.
  serviceLocation ServiceLocation @relation(fields: [serviceLocationId], references: [id], onDelete: Restrict)

  // Current field-agent assignment (ADR-023). Nullable: a job may be
  // unassigned (DRAFT/SCHEDULED). Restrict mirrors the deactivate-over-delete
  // rule — an assigned agent is soft-deactivated (`User.active = false`), never
  // hard-deleted. The assignJob action enforces that only an active FIELD_AGENT
  // may be referenced here; the DB does not encode that domain rule.
  assignedUserId String?
  assignedUser   User?   @relation("JobAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)

  status JobStatus @default(DRAFT)

  // Why the job was placed ON_HOLD (domain/jobs-lifecycle.md section 4 requires
  // ON_HOLD to carry a reason). Nullable: only meaningful for ON_HOLD, so it is
  // absent on every other status. The updateJobStatus action enforces that a
  // non-empty reason accompanies an ON_HOLD transition; the DB does not encode
  // that domain rule. Not cleared when the job resumes — the audit trail is the
  // authoritative history of each pause.
  holdReason String?

  // Why the job was CANCELED (domain/jobs-lifecycle.md section 4 requires
  // CANCELED to carry a reason). Nullable and mirrors holdReason: only set on
  // the CANCELED transition (dispatcher-only), enforced in updateJobStatus, not
  // by the DB. CANCELED is terminal, so this is written once.
  cancelReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceLocationId])
  @@index([status])
  @@index([assignedUserId])
  @@map("jobs")
}

// Immutable "who did what, when" trail for operationally significant actions
// (domain/audit-logging.md). Append-only by design: there is deliberately no
// `updatedAt` and no delete path — records are never modified once written, and
// every audit write happens in the same transaction as the change it records
// (section 4). This ticket wires only job assignment; other auditable events
// (auth, status transitions, invoices, payments) are added by their own tickets.
model AuditEvent {
  id String @id @default(cuid())

  // Server-time UTC insert clock. There is intentionally no `updatedAt`.
  occurredAt DateTime @default(now())

  // A null actor denotes a system-originated event (domain/audit-logging.md
  // section 3). Restrict mirrors the deactivate-over-delete rule: an actor
  // referenced by the trail is soft-deactivated, never hard-deleted.
  actorUserId String?
  actorUser   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorRole   Role?

  // Stable action key (e.g. "job.assigned") plus the affected record. Kept as a
  // string rather than an enum so new auditable actions don't require a
  // migration; the canonical list lives in domain/audit-logging.md section 2.
  action     String
  entityType String
  entityId   String

  summary String
  // Small structured context (e.g. { from, to, reason }). Never store secrets
  // or PII beyond what is necessary (domain/audit-logging.md section 4).
  metadata Json?

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([occurredAt])
  @@map("audit_events")
}
