# SR-App environment configuration (example)
# Copy to .env.local for development. NEVER commit a real .env.
# All values below are placeholders. Only NEXT_PUBLIC_* vars are exposed to the client.
# lib/env.ts validates these at startup (fail fast if missing/malformed).

# --- App (ADR-013) ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (ADR-002, ADR-013, ADR-020) ---
# LOCAL DEV DEFAULT: matches docker-compose.yml (run `docker compose up -d`).
# Locally there is no pooler, so DIRECT_URL == DATABASE_URL.
# DATABASE_URL is used at runtime by the Prisma pg driver adapter (lib/db);
# DIRECT_URL is used by the Prisma CLI/migrations through prisma.config.ts.
DATABASE_URL="postgresql://sr_app:sr_app_dev_password@localhost:5432/sr_app?schema=public"
DIRECT_URL="postgresql://sr_app:sr_app_dev_password@localhost:5432/sr_app?schema=public"
#
# PRODUCTION (Neon serverless Postgres, per ADR-013): set these in the deploy
# platform, NOT here. DATABASE_URL = POOLED connection (runtime);
# DIRECT_URL = DIRECT connection (Prisma migrations).
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Auth: Auth.js (NextAuth v5) Credentials (ADR-010) ---
# NOTE: Auth.js v5 uses AUTH_SECRET / AUTH_URL (NOT NEXTAUTH_SECRET). NEXTAUTH_URL
# is still honored by v5 as a fallback and is included for compatibility.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-32-byte-base64"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Session max age in seconds (ADR-015). MVP value = 12 hours (43200). Approved range: 8–24h.
AUTH_SESSION_MAX_AGE_SECONDS="43200"
# First OWNER bootstrap (seed script; idempotent, no-op if any user exists).
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-in-local-only"

# --- Object storage: Cloudflare R2, S3-compatible, server-only (ADR-008) ---
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_REGION="auto"
R2_BUCKET="sr-app-media"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"

# --- Maps & geocoding: MapTiler (ADR-009) ---
# Public, domain-restricted key for MapLibre tiles/styles (client-exposed).
NEXT_PUBLIC_MAPTILER_KEY="replace-with-domain-restricted-tiles-key"
# Server-only key used for geocoding (results are persisted, never geocoded per render).
MAPTILER_API_KEY="replace-with-server-geocoding-key"

# --- Invoicing (ADR-011) ---
# Flat tax rate in basis points (integer). 0 = no tax. Snapshotted onto invoices at finalize.
DEFAULT_TAX_RATE_BPS="0"

# --- Scheduled jobs: Vercel Cron (ADR-016) ---
# Server-only secret; Vercel sends Authorization: Bearer <CRON_SECRET> on cron invocations.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-random-32-byte-base64"
